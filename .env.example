# PostgreSQL connection string from your hosted database provider.
DATABASE_URL="postgresql://user:password@host/database"

# Admin login. Generate the hash with: npm run hash-password -- "your-password"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="salt:hash"

# Generate a long random value, for example: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: increases GitHub API limits for the public activity section.
GITHUB_TOKEN=""
